# Copy to apps/server/.env and fill in. This file is gitignored.
# Provider API keys are server-side ONLY — the browser never receives them (NFR-3).

# Anthropic (LLM: director + speaker calls)
ANTHROPIC_API_KEY=

# ElevenLabs (TTS voices, and later Scribe STT)
ELEVENLABS_API_KEY=

# Optional overrides --------------------------------------------------------

# Force the deterministic fake adapters even if keys are present (no network/cost).
# USE_FAKES=1

# Model id used for every seat + the director (per-seat override is in config.ts).
# ANTHROPIC_MODEL=claude-opus-4-8

# Director-only model. The director emits a structured move (no dialogue), so a faster,
# cheaper model shrinks the between-turns "thinking" gap. Defaults to ANTHROPIC_MODEL.
# DIRECTOR_MODEL=claude-haiku-4-5-20251001

# ElevenLabs voice ids per dog (defaults are well-known public voices).
# VOICE_REX=VR6AewLTigWG4xSOukaG
# VOICE_BELLA=21m00Tcm4TlvDq8ikWAM
# VOICE_DUKE=TxGEqnHWrfWFTfGW9XjX

# ElevenLabs model (turbo/flash = lowest latency, good for real-time).
# ELEVENLABS_MODEL=eleven_turbo_v2_5
