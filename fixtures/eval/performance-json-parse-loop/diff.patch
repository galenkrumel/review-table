@@ -1,3 +1,10 @@
 // Price table lookup.

 export type PriceTable = Record<string, number>;
+
+export function pricesFor(skus: string[], tableJson: string): number[] {
+  return skus.map((sku) => {
+    const table: PriceTable = JSON.parse(tableJson);
+    return table[sku] ?? 0;
+  });
+}
