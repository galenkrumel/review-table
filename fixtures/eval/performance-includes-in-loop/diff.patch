@@ -1,3 +1,11 @@
 // De-duplication helpers for id lists.

 export const EMPTY: string[] = [];
+
+export function uniqueIds(ids: string[]): string[] {
+  const result: string[] = [];
+  for (const id of ids) {
+    if (!result.includes(id)) result.push(id);
+  }
+  return result;
+}
