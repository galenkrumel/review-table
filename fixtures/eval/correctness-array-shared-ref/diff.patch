 export interface Board {
   cells: number[][];
   size: number;
 }
+
+/** Build a size×size board with every cell initialised to 0. */
+export function emptyBoard(size: number): Board {
+  const cells = new Array(size).fill(new Array(size).fill(0));
+  return { cells, size };
+}
