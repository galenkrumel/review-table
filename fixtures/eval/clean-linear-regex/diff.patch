@@ -1,5 +1,6 @@
 // A slug is lowercase alphanumeric words joined by single hyphens.
 export function isSlug(s: string): boolean {
-  return s.length > 0 && s.length <= 80;
+  // Anchored; the `-` separator can never be matched by [a-z0-9], so the groups are
