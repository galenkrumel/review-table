# Dependencies & build output
node_modules/
dist/
*.tsbuildinfo
.turbo/

# Secrets — never commit real keys (NFR-3). The template .env.example is kept.
.env
.env.*
!.env.example

# Eval run cache — per-run transcripts + judge verdicts. Regenerated by `pnpm eval`;
# not source. Keeping these out also keeps biome from format-checking machine JSON.
fixtures/eval/.runs/

# Generated eval reports — `EVAL-REPORT.md` plus the per-(judge,sample) snapshots
# (e.g. EVAL-REPORT.sonnet.5x.md). Machine output of `pnpm eval`, not source.
EVAL-REPORT*.md

# Inter-rater-reliability artifacts: the generated worksheet/report and the human-filled
# answers TSV (`pnpm eval --irr-worksheet` / `--irr-score`). Local experiment output, not source.
EVAL-IRR-*

# Local / editor
*.log
*.bak
*.swp
*.swo
.DS_Store
.claude/settings.local.json
